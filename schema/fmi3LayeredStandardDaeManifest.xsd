	<!-- Declares the fmi-ls-name / fmi-ls-version / fmi-ls-description attributes
	     referenced below. The DAE manifest itself has no target namespace, hence
	     import rather than include is used for the fmi-ls-manifest namespace. -->
	<xs:import namespace="http://fmi-standard.org/fmi-ls-manifest"
		schemaLocation="fmi3LayeredStandardManifest.xsd"/>

	<!--
		Root element of the FMI-LS-DAE manifest file. This layered standard provides
		its own root element, so the generic fmiLayeredStandardManifest of the core
		standard is not used. The root element and its child elements are in no XML
		namespace; only the fmi-ls-* attributes are namespace-qualified.
	-->
	<xs:element name="fmiDAEManifest">
		<xs:complexType>
			<xs:sequence>
				<xs:element name="EnableDAE" type="TEnableDAE" minOccurs="1" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="en">
							References the structural parameter in the modelDescription.xml
							that enables DAE mode.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="AlgebraicVariable" type="TAlgebraicVariable"
					minOccurs="0" maxOccurs="unbounded">
					<xs:annotation>
						<xs:documentation xml:lang="en">
							Defines an algebraic variable exposed by this DAE FMU.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="ModelStructure" type="TDaeModelStructure"
					minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="en">
							Overrides the ModelStructure in modelDescription.xml with
							DAE-aware dependency information and residual declarations.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
				<xs:element name="Annotations" type="TAnnotations"
					minOccurs="0" maxOccurs="1">
					<xs:annotation>
						<xs:documentation xml:lang="en">
							Optional annotations for the top-level element.
						</xs:documentation>
					</xs:annotation>
				</xs:element>
			</xs:sequence>
			<xs:attribute ref="fmi-ls:fmi-ls-name" use="required"
				fixed="org.fmi-standard.fmi-ls-dae"/>
			<xs:attribute ref="fmi-ls:fmi-ls-version" use="required"
				fixed="1.0.0-alpha.1"/>
			<xs:attribute ref="fmi-ls:fmi-ls-description" use="required"
				fixed="Layered standard for DAE support in FMI."/>
		</xs:complexType>
	</xs:element>

	<!-- Space-separated list of value references -->
	<xs:simpleType name="TValueReferenceList">
		<xs:list itemType="xs:unsignedInt"/>
	</xs:simpleType>

	<!-- Dependency kind as defined for dependenciesKind in the core FMI standard -->
	<xs:simpleType name="TDependencyKind">
		<xs:restriction base="xs:normalizedString">
			<xs:enumeration value="dependent"/>
			<xs:enumeration value="constant"/>
			<xs:enumeration value="fixed"/>
			<xs:enumeration value="tunable"/>
			<xs:enumeration value="discrete"/>
		</xs:restriction>
	</xs:simpleType>

	<!-- Space-separated list of dependency kinds -->
	<xs:simpleType name="TDependencyKindList">
		<xs:list itemType="TDependencyKind"/>
	</xs:simpleType>

	<!-- Single algebraic variable declaration -->
	<xs:complexType name="TAlgebraicVariable">
		<xs:attribute name="valueReference" type="xs:unsignedInt" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Value reference of the algebraic variable in ModelVariables of
					the modelDescription.xml.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="nominal" type="xs:unsignedInt">
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Optional value reference of the variable in ModelVariables of
					the modelDescription.xml that represents the nominal value of
					the algebraic variable.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Reference to the structural parameter that enables DAE mode -->
	<xs:complexType name="TEnableDAE">
		<xs:attribute name="valueReference" type="xs:unsignedInt" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Value reference of the structural parameter in ModelVariables of
					the modelDescription.xml that enables DAE mode.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Residual equation -->
	<xs:complexType name="TResidual">
		<xs:attribute name="valueReference" type="xs:unsignedInt" use="required">
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Value reference of the residual variable in ModelVariables of
					the modelDescription.xml.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="dependencies" type="TValueReferenceList">
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Space-separated list of value references this residual depends on.
					If absent, dependence on all knowns is assumed.
					If present but empty, the residual depends on no knowns.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
		<xs:attribute name="dependenciesKind" type="TDependencyKindList">
			<xs:annotation>
				<xs:documentation xml:lang="en">
					Space-separated list of dependency kinds, one per entry in
					'dependencies'. See dependenciesKind in the core FMI standard.
				</xs:documentation>
			</xs:annotation>
		</xs:attribute>
	</xs:complexType>

	<!-- Structure element shared by Output, ContinuousStateDerivative, etc. -->
	<xs:complexType name="TModelStructureElement">
		<xs:sequence>
			<xs:element name="Annotations" type="TAnnotations" minOccurs="0"/>
		</xs:sequence>
		<xs:attribute name="valueReference"   type="xs:unsignedInt" use="required"/>
		<xs:attribute name="dependencies"     type="TValueReferenceList"/>
		<xs:attribute name="dependenciesKind" type="TDependencyKindList"/>
	</xs:complexType>

	<!--
		DAE model structure.  Overrides the ModelStructure in modelDescription.xml
		when present.  All standard elements retain their core FMI semantics;
		algebraic variables may additionally appear as dependencies.
		The Residual element is new.
	-->
	<xs:complexType name="TDaeModelStructure">
		<xs:sequence>
			<xs:element name="Output"                    type="TModelStructureElement" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="ContinuousStateDerivative" type="TModelStructureElement" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="ClockedState"              type="TModelStructureElement" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="InitialUnknown"            type="TModelStructureElement" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="EventIndicator"            type="TModelStructureElement" minOccurs="0" maxOccurs="unbounded"/>
			<xs:element name="Residual"                  type="TResidual" minOccurs="0" maxOccurs="unbounded"/>
		</xs:sequence>
	</xs:complexType>

	<!-- Annotations as defined by the core FMI XML schema -->
	<xs:complexType name="TAnnotations">
		<xs:sequence maxOccurs="unbounded">
			<xs:element name="Annotation">
				<xs:complexType mixed="true">
					<xs:sequence>
						<xs:any namespace="##any" processContents="lax" minOccurs="0" maxOccurs="unbounded"/>
					</xs:sequence>
					<xs:attribute name="type" type="xs:normalizedString" use="required"/>
				</xs:complexType>
			</xs:element>
		</xs:sequence>
	</xs:complexType>
</xs:schema>
